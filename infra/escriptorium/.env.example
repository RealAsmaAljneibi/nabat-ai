# infra/escriptorium/.env.example
# ================================
# Copy this to .env and fill in the values before running docker compose up.
# DO NOT commit the filled-in .env to git — it contains secrets.

# Django secret key — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production

# Postgres credentials
POSTGRES_DB=escriptorium
POSTGRES_USER=escriptorium
POSTGRES_PASSWORD=choose-a-strong-password

# eScriptorium admin user (created with: docker compose exec app python manage.py createsuperuser)
ESCR_ADMIN_USER=admin
ESCR_ADMIN_PASS=choose-a-strong-password

# Port eScriptorium will be accessible on (default: 8080)
ESCR_PORT=8080

# API token (obtained after createsuperuser with:
#   docker compose exec app python manage.py drf_create_token admin
# Then copy the token string here AND into the root .env as ESCR_API_TOKEN)
ESCR_API_TOKEN=
