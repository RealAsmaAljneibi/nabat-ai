# NABAT-AI — Environment Configuration
# ──────────────────────────────────────────────────────────────────────
# HOW TO USE THIS FILE:
#   1. Copy it:   cp .env.example .env
#   2. Get a free API key (takes ~2 minutes — see instructions below)
#   3. Paste the key next to LLM_API_KEY= below
#   4. Run:       streamlit run app/streamlit_app.py
#
# ── Getting your free API key ──────────────────────────────────────────
#
#   OPTION A — Together.ai (recommended, default):
#     → Go to:   https://api.together.xyz
#     → Click "Sign Up"  (free, no credit card needed)
#     → After login: click your name (top right) → "API Keys" → "Create"
#     → Copy the key and paste it after LLM_API_KEY= below
#     → Keep LLM_PROVIDER=together  (already set below)
#
#   OPTION B — Groq (also free):
#     → Go to:   https://console.groq.com
#     → Click "Sign Up"  (free, no credit card needed)
#     → After login: click "API Keys" in the left menu → "Create API Key"
#     → Copy the key and paste it after LLM_API_KEY= below
#     → Change LLM_PROVIDER=groq  below
#
#   OFFLINE / NO KEY:
#     → Set LLM_PROVIDER=stub  and leave LLM_API_KEY= blank
#     → The app runs with canned responses — good for checking the UI
#       layout without internet access. Answers will not be real poetry.
#
# ── What each key is used for ─────────────────────────────────────────
#   The API key is used ONLY for LLM inference (generating answers).
#   Embeddings run locally (no key needed).
#   Tab A eScriptorium uses a local Docker container (no external key).
#   No other external services are called.
# ──────────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────────
# Choose one: "together" | "groq" | "stub"
LLM_PROVIDER=together

# Paste your API key here (from Together.ai or Groq — see above)
LLM_API_KEY=

# Primary model (Qwen2.5-7B). Fallback is Mistral-7B (see §5 of IMPLEMENTATION_PLAN.md).
# Together.ai model IDs:
LLM_MODEL_PRIMARY=Qwen/Qwen2.5-7B-Instruct-Turbo
LLM_MODEL_FALLBACK=mistralai/Mistral-7B-Instruct-v0.3

# Groq model IDs (uncomment if LLM_PROVIDER=groq):
# LLM_MODEL_PRIMARY=qwen-qwq-32b
# LLM_MODEL_FALLBACK=mistral-saba-24b

# ── Embedding ─────────────────────────────────────────────────────────
# GATE-AraBERT-v1 for dense Arabic embeddings (runs locally — no key needed).
EMBED_MODEL=aubmindlab/bert-base-arabertv02

# ── Vector Store ─────────────────────────────────────────────────────
# File-backed Qdrant collection — portable, no separate server needed.
QDRANT_PATH=data/qdrant

# ── eScriptorium (optional — only needed for Tab A Archive Manager) ───
# If not running, Tab A degrades gracefully. Tab B (RAG) works without it.
# No external API key needed — eScriptorium is self-hosted via Docker.
ESCR_BASE_URL=http://localhost:8080
ESCR_API_TOKEN=
# ESCR_ADMIN_USER=admin
# ESCR_ADMIN_PASS=
