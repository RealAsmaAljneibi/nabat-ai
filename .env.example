# NABAT-AI — Environment Configuration
# ──────────────────────────────────────────────────────────────────────
# HOW TO USE THIS FILE:
#   1. Copy it:   cp .env.example .env
#   2. Get an API key (see options below — takes ~2 minutes)
#   3. Paste the key into the matching variable below
#   4. Run:       streamlit run app/streamlit_app.py
#
# ── Getting your API key ───────────────────────────────────────────────
#
#   OPTION A — OpenAI (recommended — best Arabic + bilingual quality):
#     → Go to:   https://platform.openai.com/api-keys
#     → Click "Create new secret key" → copy it
#     → Paste the key after OPENAI_API_KEY= below
#     → Keep LLM_PROVIDER=openai  (already set below)
#     → Models: gpt-4o-mini (primary) / gpt-4o (fallback) — auto-selected
#
#   OPTION B — Together.ai (free tier, no credit card):
#     → Go to:   https://api.together.xyz
#     → Click "Sign Up"  (free, no credit card needed)
#     → After login: click your name (top right) → "API Keys" → "Create"
#     → Paste the key after TOGETHER_API_KEY= below
#     → Set LLM_PROVIDER=together  below
#
#   OPTION C — Groq (also free, very fast):
#     → Go to:   https://console.groq.com
#     → Click "Sign Up"  (free, no credit card needed)
#     → After login: click "API Keys" in the left menu → "Create API Key"
#     → Paste the key after GROQ_API_KEY= below
#     → Set LLM_PROVIDER=groq  below
#
#   TIP: Set all keys at once — then switching providers requires only changing
#   LLM_PROVIDER above. No copy-pasting keys every time.
#
#   OFFLINE / NO KEY:
#     → Set LLM_PROVIDER=stub  and leave all keys blank
#     → The app runs with canned responses — good for checking the UI
#       layout without internet access. Answers will not be real poetry.
#
# ── What each key is used for ─────────────────────────────────────────
#   The API key is used ONLY for LLM inference (generating answers).
#   Embeddings run locally (no key needed).
#   Tab B eScriptorium uses a local Docker container (no external key).
#   No other external services are called.
# ──────────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────────
# Choose one: "openai" | "together" | "groq" | "stub"
LLM_PROVIDER=openai

# ── API Keys — store all of them; only the active provider's key is used ──
OPENAI_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=

# Legacy fallback — used only if the provider-specific key above is blank.
LLM_API_KEY=

# ── Model overrides (optional) ────────────────────────────────────────
# Models are auto-selected per provider — only set these to override:
#
#   OpenAI defaults:
#     LLM_MODEL_PRIMARY=gpt-4o-mini
#     LLM_MODEL_FALLBACK=gpt-4o
#
#   Together.ai defaults:
#     LLM_MODEL_PRIMARY=Qwen/Qwen2.5-7B-Instruct-Turbo
#     LLM_MODEL_FALLBACK=mistralai/Mistral-7B-Instruct-v0.3
#
#   Groq defaults:
#     LLM_MODEL_PRIMARY=qwen-qwq-32b
#     LLM_MODEL_FALLBACK=mistral-saba-24b
#
# Uncomment and edit only if you need a specific model:
# LLM_MODEL_PRIMARY=gpt-4o-mini
# LLM_MODEL_FALLBACK=gpt-4o

# ── Embedding ─────────────────────────────────────────────────────────
# GATE-AraBERT-v1 for dense Arabic embeddings (runs locally — no key needed).
EMBED_MODEL=aubmindlab/bert-base-arabertv02

# ── Vector Store ─────────────────────────────────────────────────────
# File-backed Qdrant collection — portable, no separate server needed.
QDRANT_PATH=data/qdrant

# ── Poet Bio Enrichment (optional) ───────────────────────────────────
# Wikipedia lookups are FREE — no key needed. They work automatically.
# Brave Search is an OPTIONAL fallback for poets not found on Wikipedia.
#
#   How to get a free Brave Search key:
#     → Go to: https://brave.com/search/api/
#     → Sign up → "Create API key" → paste below
#     → Free tier: 2,000 searches/month (well above our enrichment needs)
#
# Leave BRAVE_API_KEY empty to use Wikipedia-only mode (still very useful).
BRAVE_API_KEY=

# ── eScriptorium (optional — only needed for Tab B Archive Manager) ───
# If not running, Tab B degrades gracefully. Tab A (Scholar Workbench) works without it.
# No external API key needed — eScriptorium is self-hosted via Docker.
ESCR_BASE_URL=http://localhost:8080
ESCR_API_TOKEN=
# ESCR_ADMIN_USER=admin
# ESCR_ADMIN_PASS=
